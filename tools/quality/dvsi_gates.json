  "ambe2450-imbe-encoders": {
    "description": "AMBE+2 and IMBE encoders: our encoding, decoded by this library, keeps DVSI's level, fits the input at least as well as DVSI's own encoding, stays on pitch and voices like DVSI, sends no tone frames for speech, and clips no more than a few samples where the input itself reaches the rails (t03, t04); the decoders and the D-STAR encoder are untouched (D-STAR's encoded bits identical, so the baseline must record encoder-row hashes).",
    "partition": "validation",
    "checks": [
      {
        "mode": [
          "r33",
          "p25"
        ],
        "metric": "encoder.alignment_failures",
        "rule": "max",
        "value": 0
      },
      {
