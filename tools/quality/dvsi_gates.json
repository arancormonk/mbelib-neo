{
  "pitch-law": {
    "description": "D-STAR pitch law: decoded pitch matches DVSI, quality improves, level and band balance hold, other modes untouched.",
    "partition": "validation",
    "checks": [
      {
        "mode": "dstar",
        "metric": "pitch.dvsi_max_band_deviation",
        "rule": "max",
        "value": 0.003
      },
      {
        "mode": "dstar",
        "metric": "pitch.input_max_band_deviation",
        "rule": "max",
        "value": 0.006
      },
      {
        "mode": "dstar",
        "metric": "ours.lsd_db",
        "rule": "decrease"
      },
      {
        "mode": "dstar",
        "metric": "ours.env_corr",
        "rule": "increase"
      },
      {
        "mode": "dstar",
        "metric": "ours.level_offset_db",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_0_500",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_500_1000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_1000_2000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_2000_3000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_3000_4000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_3500_4000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.pcm_rail_samples",
        "rule": "no_increase"
      },
      {
        "mode": "dstar",
        "metric": "encoder.pitch_cents_median",
        "rule": "decrease"
      },
      {
        "mode": "dstar",
        "metric": "encoder.voicing_agreement_mean",
        "rule": "no_decrease",
        "value": 0.005
      },
      {
        "mode": "dstar",
        "metric": "encoder.lsd_db",
        "rule": "no_increase",
        "value": 0.05
      },
      {
        "mode": [
          "p25",
          "r33"
        ],
        "metric": "ours.lsd_db",
        "rule": "abs_delta_max",
        "value": 0.0,
        "worst": 0.0
      },
      {
        "mode": [
          "p25",
          "r33"
        ],
        "metric": "speech.pcm_changed_vectors",
        "rule": "max",
        "value": 0
      }
    ]
  },
