        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_3000_4000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.band_delta_db_3500_4000",
        "rule": "abs_delta_max",
        "value": 0.3
      },
      {
        "mode": "dstar",
        "metric": "ours.pcm_rail_samples",
        "rule": "no_increase"
      },
      {
        "mode": "dstar",
        "metric": "encoder.pitch_cents_median",
        "rule": "decrease"
      },
      {
        "mode": "dstar",
